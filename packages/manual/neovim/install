#!/usr/bin/env bash

set -Eeuo pipefail

source "$DOTFILES"/_helpers/core

info "Installing Neovim"

need_all ninja cmake gettext curl git

TMP=$(mktemp -d) || error "Failed to create temporary directory"
trap 'rm -rf "$TMP"' EXIT

REPO=https://github.com/neovim/neovim
DIR=$TMP/neovim

# Branch or tag
BRANCH=master

# Use --revision=<rev> for a specific arbitrary commit.
# This is incompatible with --branch=<branch>.
git clone --branch "$BRANCH" --depth=1 "$REPO" "$DIR"
cd "$DIR"

BUILD_TYPE=Release
INSTALL_PREFIX=$HOME/opt/nvim

rm -rf build/

make \
  CMAKE_BUILD_TYPE="$BUILD_TYPE" \
  CMAKE_EXTRA_FLAGS="-DCMAKE_INSTALL_PREFIX=$INSTALL_PREFIX" ||
  error "Build failed"

make install || error "Install failed"

success "Installed neovim"
